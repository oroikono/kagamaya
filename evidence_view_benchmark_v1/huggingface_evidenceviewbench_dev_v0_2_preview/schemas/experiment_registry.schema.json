{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidenceviewbench.experiment_registry.v1",
  "type": "object",
  "required": ["schema_version", "release_version", "claims"],
  "properties": {
    "schema_version": {"const": "evidenceviewbench.experiment_registry.v1"},
    "release_version": {"const": "0.1.2"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id", "headline", "status", "split", "denominators",
          "evidence", "checks", "source_hashes", "claim_ceiling"
        ],
        "properties": {
          "claim_id": {"pattern": "^EVB-[0-9]{3}$"},
          "status": {
            "enum": [
              "finite_empirical", "finite_negative_control",
              "finite_sensitivity", "structural_validation"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "file_sha256"],
              "properties": {
                "path": {"type": "string"},
                "file_sha256": {"pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
