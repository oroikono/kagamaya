{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_view_benchmark.trace.v1",
  "title": "EvidenceViewEnv deterministic trace",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "public_case_sha256",
    "acquisition_bank_file_sha256",
    "case_registry_file_sha256",
    "budget",
    "visibility",
    "producer",
    "events",
    "spent",
    "remaining",
    "tool_calls",
    "done",
    "termination",
    "trace_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evidence_view_benchmark.trace.v1"},
    "case_id": {"type": "string"},
    "public_case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acquisition_bank_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_registry_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "budget": {"type": "integer", "minimum": 0},
    "visibility": {"const": "acquire_only"},
    "producer": {"enum": ["spectral_etdrk4", "fd_bdf"]},
    "events": {"type": "array", "minItems": 1},
    "spent": {"type": "integer", "minimum": 0},
    "remaining": {"type": "integer", "minimum": 0},
    "tool_calls": {"type": "integer", "minimum": 0, "maximum": 12},
    "done": {"type": "boolean"},
    "termination": {
      "type": ["string", "null"],
      "enum": [null, "COMMIT", "VOLUNTARY_ABSTENTION", "FORCED_ABSTENTION"]
    },
    "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
